:@@WEB_UI_PORT@@ {
	root * /var/www/adminer/public
	encode zstd gzip
	file_server

	request_body {
		max_size 50GB
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Robots-Tag "none"
		Content-Security-Policy "frame-ancestors 'self'"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}

	@directPhp path *.php
	respond @directPhp 404

	php_fastcgi 127.0.0.1:9999
}
